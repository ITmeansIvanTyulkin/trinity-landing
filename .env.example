# Supabase (cabinet + future IMOEX shared auth)
# Copy values into js/cabinet-config.local.js — static site does not load .env at runtime.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Phase 2 IMOEX only (JWT secret — never expose to browser / landing)
# SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
